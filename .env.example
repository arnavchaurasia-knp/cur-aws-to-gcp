PORT=8080
DATA_DIR=/var/data/cur-web
# ANTIGRAVITY_API_KEY is read from the host environment (set VM-wide on prod;
# shell or system on dev). cur-web does not parse it — the spawned agy
# subprocess inherits it via os.Environ(). GEMINI_API_KEY is ignored by agy.
ANTIGRAVITY_API_KEY=AQ....
AGY_MODEL=gemini-3.8-flash
# SKILL_DIR overrides the default skill lookup path (~/.gemini/.../skills/aws-gcp-cost-projection-gemini).
# Set this in the systemd unit or shell if the skill is installed to a non-standard location.
# SKILL_DIR=/path/to/skill/aws-gcp-cost-projection

# GOOGLE_CLOUD_API_KEY: enables live GCP Cloud Billing Catalog API lookups —
# used as the last-resort fallback in apply_static_mappings.py's resolve_sku()
# when a SKU isn't in the bundled catalog snapshot, and by
# scripts/catalog_health_check.py --refresh (auto-run weekly by
# internal/jobs/catalog_refresher.go) to pull fresh/missing SKU files.
# Create it in Google Cloud Console → APIs & Services → Credentials → Create
# API Key, in a project with the "Cloud Billing API" enabled, then restrict
# the key to that API. No billing-account access is needed — the Catalog API
# only serves public list pricing.
# GOOGLE_CLOUD_API_KEY=AIza...

# GOOGLE_CLOUD_AVAILABILITY_PROJECT / GOOGLE_CLOUD_AVAILABILITY_TOKEN: enable
# LIVE GCP availability checks at mapping time (apply_static_mappings.py's
# _family_phantom_unavailable() and its per-service adapters), each run once
# per job process and cached for its lifetime. These check actual
# deployability, which can genuinely disagree with the Billing Catalog's
# pricing data in either direction — confirmed real: N4D showed as
# priced-but-undeployable in Compute Engine's asia-south2 on 2026-07-24, then
# genuinely deployable there by 2026-10-04, and a hardcoded exception table
# has no way to know when that changes.
#
# Services covered today, each via its own adapter (checked live before
# adding, not assumed from docs):
#   Compute Engine                     machineTypes.aggregatedList (full
#                                       catalog fetch, ~90s first call, then
#                                       instant for the rest of that job)
#   Cloud Filestore                    locations.list (fast, <2s)
#   Cloud Memorystore for Redis        locations.list (fast, <2s)
#   Cloud Memorystore for Memcached    locations.list (fast, <2s)
#   BigQuery Reservation API           locations.list (fast, <2s)
#   Firestore                          locations.list (fast, <2s)
#   Kubernetes Engine (GKE)            per-region serverConfig -- POSITIVE
#                                       signal only (an error response is
#                                       ambiguous, so this can confirm a
#                                       region IS available but never forces
#                                       one unavailable)
#   Cloud Composer                     per-region environments.list -- FULL
#                                       signal both ways (confirmed live:
#                                       clean HTTP 200 for a real region vs.
#                                       a specific HTTP 400 "Unexpected
#                                       location: X" for an invalid one, not
#                                       an ambiguous error like GKE's)
# Confirmed NOT covered (API enabled, still no per-region availability
# signal): Cloud SQL Admin API, base BigQuery (BigQuery Reservation API above
# is a separate service that IS covered), Cloud Pub/Sub (arguably not even a
# meaningful question — Pub/Sub is a global service). Falls back to
# catalog-only + the hand-curated _KNOWN_PHANTOM_AVAILABILITY table for these,
# same as before this feature existed.
# UNTESTED (neither confirmed covered nor confirmed not): Dataproc --
# enabling its API requires Compute Engine, which requires a billing account
# this session didn't have access to on any available probe project.
#
# GOOGLE_CLOUD_AVAILABILITY_PROJECT: any GCP project with the relevant APIs
# enabled (Compute Engine, Filestore, Memorystore Redis/Memcached, BigQuery
# Reservation, Firestore, Kubernetes Engine, Cloud Composer) — the data
# returned is a platform-wide fact, not specific to that project's own
# deployed resources, so it doesn't need to be a "real" workload project.
#
# The Compute Engine check also refreshes data/compute_family_availability.
# json automatically once a day (internal/jobs/compute_availability_
# refresher.go, same pattern as the weekly Billing Catalog refresh) as long
# as these two env vars are set on the server — no separate cron/maintainer
# step needed.
# GOOGLE_CLOUD_AVAILABILITY_TOKEN: a pre-provisioned OAuth2 bearer token for
# an identity with roles/viewer (or the narrower per-service *.viewer roles)
# on that project — NOT the same as GOOGLE_CLOUD_API_KEY above (a bare API
# key cannot authorize reading a project's own resources, only the public
# Billing Catalog). Generate one short-lived via
# `gcloud auth print-access-token`, or mint a longer-lived one for a
# dedicated service account for production use.
#
# If neither is set, the Compute Engine check falls back to
# data/compute_family_availability.json (refreshed via
# scripts/verify_compute_availability.py as a periodic maintainer step); every
# other service falls straight back to catalog-only +
# _KNOWN_PHANTOM_AVAILABILITY — a job is never blocked or slowed by this
# being unconfigured.
# GOOGLE_CLOUD_AVAILABILITY_PROJECT=my-probe-project
# GOOGLE_CLOUD_AVAILABILITY_TOKEN=ya29...

GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=https://cur.facets.cloud/api/auth/callback
SESSION_SECRET=<base64-encoded 32-byte random value — generate with: openssl rand -base64 32>
RESEND_API_KEY=re_...
RESEND_FROM=Facets <noreply@facets.cloud>
APP_BASE_URL=https://cur.facets.cloud
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ALLOWED_DOMAINS: comma-separated Google Workspace domains allowed to log in.
# Defaults to "google.com,facets.cloud" if unset. Add your domain here if different.
# ALLOWED_DOMAINS=facets.cloud,yourdomain.com

# ADMIN_EMAILS: comma-separated emails that can see all jobs via /admin.
# Leave unset to disable admin access entirely.
# ADMIN_EMAILS=you@facets.cloud

# LOG_LEVEL=debug enables verbose structured logging (default: info).
# LOG_FORMAT=text switches from JSON to human-readable logs for local dev.
# LOG_LEVEL=debug
# LOG_FORMAT=text

# --- Local development only ---
# When DEV_AUTH_BYPASS=true:
#   - Google/Resend/Slack env vars are not required
#   - /api/auth/login sets a fake dev@google.com session immediately
#   - Cookies are non-Secure if APP_BASE_URL is http://
# DO NOT enable in production.
# DEV_AUTH_BYPASS=true
